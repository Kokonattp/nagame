# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
**/__pycache__/

docs/BUILD-STATE.md.autoloop.json
docs/BUILD-STATE.md.autoloop.log

# autoloop runtime sidecar (ไม่ใช่ของโปรเจกต์)
docs/BUILD-STATE.md.autoloop.*

# Tabi place-store build cache (Wikipedia text used only as Jev input)
data/places/_cache/

# live-search worker's result cache
workers/live-search/live-search-cache.json*

# copied from node_modules by scripts/copy-maplibre-worker.mjs (postinstall)
public/maplibre/
